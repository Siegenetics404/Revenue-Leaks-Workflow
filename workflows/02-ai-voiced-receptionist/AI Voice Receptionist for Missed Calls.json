    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT to_char(s, 'HH24:MI') AS slot\nFROM generate_series($1::date + time '09:00', $1::date + time '16:30', interval '30 minutes') AS s\nWHERE EXTRACT(ISODOW FROM $1::date) < 6\n  AND s > (NOW() AT TIME ZONE 'Asia/Manila')\n  AND NOT EXISTS (\n    SELECT 1 FROM appointments a WHERE a.slot_start = s AND a.status = 'booked'\n  )\nORDER BY s\nLIMIT 3;",
