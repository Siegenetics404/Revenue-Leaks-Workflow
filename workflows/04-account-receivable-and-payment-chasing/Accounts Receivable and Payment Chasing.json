    {
      "parameters": {
        "jsCode": "const raw = $json.output?.[0]?.content?.[0]?.text ?? $json.message?.content ?? $json.content ?? \"\";\n\nlet parsed;\ntry {\n  parsed = typeof raw === \"string\"\n    ? JSON.parse(raw.replace(/```json|```/g, \"\").trim())\n    : raw;\n} catch (e) {\n  return [{ json: { ...$('Loop Invoices').item.json, valid: false, fail: \"unparseable\" } }];\n}\n\nconst src = $('Loop Invoices').item.json;\nconst body = (parsed.body || \"\").trim();\nconst words = body.split(/\\s+/).length;\n\nconst amountStr = Number(src.amount).toLocaleString();\n\nconst checks = {\n  hasBody:           body.length > 30,\n  lengthOk:          words >= 35 && words <= 110,\n  hasInvoiceNumber:  body.includes(src.invoice_number),\n  hasAmount:         body.includes(amountStr) || body.includes(String(src.amount)),\n  noExtraMoney:      (body.match(/[\\$£€]\\s?\\d[\\d,]*(\\.\\d+)?/g) || []).length <= 1,\n  noCollectionsLang: !/collections?|legal action|credit report|attorney/i.test(body),\n  noInventedTerms:   !/late fee|interest charge|discount|waive/i.test(body),\n  hasSubject:        (parsed.subject || \"\").length > 5 && parsed.subject.length < 70\n};\n\nconst failed = Object.entries(checks).filter(([,v]) => !v).map(([k]) => k);\n\nreturn [{ json: {\n  ...src,\n  subject: parsed.subject,\n  body,\n  valid: failed.length === 0,\n  fail: failed.join(\",\")\n}}];"
      },
