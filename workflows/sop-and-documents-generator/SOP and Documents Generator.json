      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst text = (msg.text || '').replace(/\\\\n/g, '\\n');\nconst lines = text.split('\\n');\n\nconst titleLine = lines.find(l => l.trim().toUpperCase().startsWith('TITLE:'));\nconst title = titleLine\n  ? titleLine.replace(/TITLE:/i, '').trim()\n  : 'Untitled SOP';\nconst body = lines.filter(l => l !== titleLine).join('\\n').trim();\n\nreturn [{\n  json: {\n    title,\n    raw_input: body,\n    submitted_by: msg.from.username || String(msg.from.id),\n    chat_id: msg.chat.id\n  }\n}];"
      },
