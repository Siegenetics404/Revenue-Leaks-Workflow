    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst s = d.sop;\n\nconst clean = (arr) => (Array.isArray(arr) ? arr : [])\n  .map(x => String(x ?? '').trim())\n  .filter(Boolean);\n\nconst cap = (t) => String(t ?? '')\n  .replace(/\\b\\w/g, c => c.toUpperCase());\n\nconst tidy = (t) => String(t ?? '').trim().replace(/\\.$/, '');\nconst cap1 = (t) => { t = tidy(t); return t.charAt(0).toUpperCase() + t.slice(1); };\n\nconst roles = clean(s.roles).map(cap);\nconst tools = clean(s.tools);\nconst prerequisites = clean(s.prerequisites);\nconst exceptions = clean(s.exceptions);\nconst warnings = clean(s.warnings);\n\nlet md = `# ${d.title}\\n\\n`;\nmd += `**Purpose:** ${s.purpose}\\n\\n`;\nmd += `**Roles involved:** ${roles.join(', ')}\\n\\n`;\nmd += `**Tools and systems:** ${tools.join(', ')}\\n\\n`;\n\nif (prerequisites.length) {\n  md += `## Prerequisites\\n` + prerequisites.map(p => `- ${p}`).join('\\n') + '\\n\\n';\n}\n\nmd += `## Steps\\n`;\nmd += s.steps.map(st => {\n  const action = cap1(st.action);\n  const showTool = st.tool && !action.toLowerCase().includes(String(st.tool).toLowerCase());\n  return `${st.order}. ${cap(st.actor)}: ${action}${showTool ? ` (via ${st.tool})` : ''}.`;\n}).join('\\n') + '\\n\\n';\n\nif (exceptions.length) {\n  md += `## Exceptions\\n` + exceptions.map(e => `- ${e}`).join('\\n') + '\\n\\n';\n}\nif (warnings.length) {\n  md += `## Warnings\\n` + warnings.map(w => `- ⚠️ ${w}`).join('\\n') + '\\n\\n';\n}\n\nmd += `---\\n*Version ${d.version_number} · Completeness ${d.completeness_score}/100*`;\n\nreturn [{ json: { ...d, rendered_markdown: md } }];"
      },
