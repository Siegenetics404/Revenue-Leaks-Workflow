        "jsCode": "const { toolCallId, date } = $('Parse Availability Call').first().json;\nconst slots = $input.all().map(i => i.json.slot).filter(Boolean);\nconst result = slots.length\n  ? `Open times on ${date}: ${slots.join(\", \")}. Offer these to the caller.`\n  : `No openings on ${date}. Ask the caller for a different weekday.`;\nreturn [{ json: { results: [{ toolCallId, result }] } }];"
