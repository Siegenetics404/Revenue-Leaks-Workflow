    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO appointments (slot_start, caller_name, caller_number, reason, call_id)\nSELECT s, $2::text, $3::text, $4::text, $5::text\nFROM (SELECT $1::timestamp AS s) t\nWHERE s::time BETWEEN '09:00' AND '16:30'\n  AND EXTRACT(ISODOW FROM s) < 6\n  AND EXTRACT(MINUTE FROM s) IN (0, 30)\n  AND s > (NOW() AT TIME ZONE 'Asia/Manila')\nON CONFLICT (slot_start) DO NOTHING\nRETURNING to_char(slot_start, 'FMDay FMHH12:MI AM') AS booked;",
        "options": {
          "queryReplacement": "={{ [$json.date_time, $json.caller_name, $json.caller_number, $json.reason, $json.call_id] }}"
