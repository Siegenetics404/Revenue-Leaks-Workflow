    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst text = (msg.text || '').trim();\nconst REVIEWER_CHAT_ID = 5611798761;\n\nlet decision = null;\nlet feedback = '';\n\nif (/^approve\\b/i.test(text)) {\n  decision = 'approved';\n} else if (/^reject\\b/i.test(text)) {\n  decision = 'rejected';\n} else if (/^revise\\s*:/i.test(text)) {\n  decision = 'revision_requested';\n  feedback = text.replace(/^revise\\s*:/i, '').trim();\n}\n\nreturn [{\n  json: {\n    raw_reply: text,\n    decision,\n    feedback,\n    chat_id: msg.chat.id,\n    reviewer: msg.from.username || String(msg.from.id),\n    is_reviewer: msg.chat.id === REVIEWER_CHAT_ID\n  }\n}];"
      },
