            {
              "role": "system",
              "content": "Classify this email reply into exactly one category.\n\nCategories:\nINTERESTED - wants to talk, asks about pricing or availability\nQUESTION - asks something but is not committing\nNOT_NOW - interested later, says busy or wrong timing\nNOT_INTERESTED - declines\nUNSUBSCRIBE - asks to stop contact, angry, or legal language\nAUTO_REPLY - out of office, bounce, autoresponder\n\nReturn ONLY: {\"category\":\"...\", \"confidence\":0.0-1.0, \"summary\":\"under 15 words\"}"
            },
            {
              "content": "={{ $('Extract Reply Text').item.json.reply }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
