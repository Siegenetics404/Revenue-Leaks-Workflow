    {
      "parameters": {
        "jsCode": "const YOUR_EMAIL = 'franco.cj03@gmail.com';\n\nconst rawFrom = $json.from?.value?.[0]?.address || $json.from || '';\nconst emailMatch = rawFrom.match(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/);\nconst fromAddress = emailMatch ? emailMatch[0] : rawFrom;\n\n// Skip anything that's actually from you (your own sent copies picked up by the label)\nif (fromAddress.toLowerCase() === YOUR_EMAIL.toLowerCase()) {\n  return [];\n}\n\nconst body = $json.textPlain || $json.text || $json.textHtml?.replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ') || \"\";\nconst clean = body.split(/On .* wrote:|-----Original Message-----|^>/m)[0].trim();\n\nreturn [{ json: { from: fromAddress, reply: clean.slice(0, 1500) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "41f17083-05b3-453c-a98b-5a695e7c4ab7",
      "name": "Extract Reply Text"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output?.[0]?.content?.[0]?.text ?? $json.message?.content ?? $json.content ?? \"\";\nlet parsed;\ntry {\n  parsed = typeof raw === \"string\"\n    ? JSON.parse(raw.replace(/```json|```/g, \"\").trim())\n    : raw;\n} catch (e) {\n  parsed = { category: \"PARSE_ERROR\", confidence: 0, summary: \"Could not parse classification\" };\n}\n\nreturn [{ json: {\n  ...$('Find Matching Lead').item.json,\n  category: parsed.category,\n  confidence: parsed.confidence,\n  summary: parsed.summary,\n  reply_text: $('Extract Reply Text').item.json.reply\n}}];"
      },
