    {
      "parameters": {
        "jsCode": "const ctx = $('Set Document ID').first().json;\nconst version = $('Get Next Version').first().json.next_version;\nconst input = $input.first().json;\n\nconst raw = input.output?.[0]?.content?.[0]?.text\n  ?? input.message?.content\n  ?? input.content\n  ?? \"\";\n\nlet sop;\ntry {\n  sop = typeof raw === \"string\"\n    ? JSON.parse(raw.replace(/```json|```/g, \"\").trim())\n    : raw;\n} catch (e) {\n  return [{ json: {\n    ...ctx,\n    version_number: version,\n    sop: null,\n    valid: false,\n    completeness_score: 0,\n    missing_fields: \"unparseable_output\"\n  }}];\n}\n\nconst steps = Array.isArray(sop.steps) ? sop.steps : [];\n\nconst checks = {\n  hasPurpose:        (sop.purpose || \"\").length > 10,\n  hasRoles:          Array.isArray(sop.roles) && sop.roles.length > 0,\n  hasTools:          Array.isArray(sop.tools) && sop.tools.length > 0,\n  enoughSteps:       steps.length >= 3,\n  stepsHaveActor:    steps.length > 0 && steps.every(s => s.actor && s.actor.length > 0),\n  stepsOrdered:      steps.length > 0 && steps.every((s, i) => s.order === i + 1),\n  exceptionsPresent: Array.isArray(sop.exceptions)\n};\n\nconst failed = Object.entries(checks).filter(([, v]) => !v).map(([k]) => k);\nconst score = Math.round(100 * (Object.keys(checks).length - failed.length) / Object.keys(checks).length);\n\nreturn [{ json: {\n  ...ctx,\n  version_number: version,\n  sop,\n  completeness_score: score,\n  missing_fields: failed.join(\", \"),\n  valid: score >= 80\n}}];"
      },
