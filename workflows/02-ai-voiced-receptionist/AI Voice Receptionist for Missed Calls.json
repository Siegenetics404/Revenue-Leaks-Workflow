      "parameters": {
        "jsCode": "const m = $json.body.message;\nconst call = m.call || {};\nconst transcript = m.artifact?.transcript || m.transcript || \"\";\nconst start = m.startedAt || call.startedAt || call.createdAt;\nconst end = m.endedAt || call.endedAt;\n\nreturn [{ json: {\n  call_id: call.id,\n  caller_number: call.customer?.number || \"web-call\",\n  started_at: start,\n  duration_sec: Math.round(m.durationSeconds ?? (new Date(end) - new Date(start)) / 1000),\n  ended_reason: m.endedReason || \"\",\n  transcript,\n  recording_url: m.artifact?.recordingUrl || m.recordingUrl || \"\",\n  user_turns: (transcript.match(/^User:/gm) || []).length\n}}];"
