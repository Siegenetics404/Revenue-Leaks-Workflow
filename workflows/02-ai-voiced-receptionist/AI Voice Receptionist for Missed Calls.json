      "parameters": {
        "operation": "executeQuery",
        "query": "WITH u AS (\n  UPDATE calls SET\n    caller_name = $2, reason = $3, urgency = $4,\n    wants_appointment = $5::boolean, callback_needed = $6::boolean,\n    summary = $7,\n    status = CASE WHEN $8::boolean THEN 'handled' ELSE 'needs_review' END\n  WHERE call_id = $1\n  RETURNING *\n)\nSELECT u.*, to_char(a.slot_start, 'FMDay FMHH12:MI AM') AS booked_slot\nFROM u LEFT JOIN appointments a ON a.call_id = u.call_id;",
        "options": {
