      "parameters": {
        "jsCode": "function stageFor(daysOverdue) {\n  if (daysOverdue < 0) return null; // not due yet, skip\n  if (daysOverdue < 7) return 0;\n  if (daysOverdue < 21) return 1;\n  if (daysOverdue < 45) return 2;\n  return 3;\n}\n\nreturn $input.all()\n  .map(item => {\n    const l = item.json;\n    const stage = stageFor(l.days_overdue);\n    if (stage === null) return null;\n    return { json: { ...l, stage } };\n  })\n  .filter(Boolean);"
      },
      "type": "n8n-nodes-base.code",
